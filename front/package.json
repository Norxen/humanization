{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "docs:generate": "node scripts/generate-docs-manifest.mjs",
    "prestart": "npm run docs:generate && npm run firebase:config:local",
    "start": "ng serve",
    "prebuild": "npm run docs:generate",
    "build": "ng build",
    "postbuild": "node scripts/create-spa-fallback.mjs",
    "prewatch": "npm run docs:generate",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run docs:generate",
    "test:docs": "node --test scripts/generate-docs-manifest.test.mjs",
    "test:rules": "firebase emulators:exec --project=manuscript-rules-test --only firestore \"node --test scripts/firestore.rules.test.mjs\"",
    "functions:build": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "test": "npm run test:docs && npm run test:functions && ng test",
    "dev:local": "npm run functions:build && firebase emulators:exec --project=humanization-1c628 --only auth,firestore,functions \"npm run firebase:migrate:projects:emulator && npm start\"",
    "prefirebase:emulators": "npm run functions:build",
    "firebase:emulators": "firebase emulators:start --project=humanization-1c628 --only auth,firestore,functions",
    "firebase:seed": "node scripts/seed-firestore.mjs",
    "firebase:seed:emulator": "npm run docs:generate && node scripts/seed-firestore.mjs --emulator --project=humanization-1c628",
    "firebase:auth:emulator": "node scripts/setup-auth-emulator.mjs",
    "firebase:migrate:projects": "npm run docs:generate && node scripts/migrate-projects.mjs",
    "firebase:migrate:projects:emulator": "npm run firebase:auth:emulator && npm run docs:generate && node scripts/seed-firestore.mjs --emulator --project=humanization-1c628 && node scripts/migrate-projects.mjs --emulator --project=humanization-1c628 --owner=editor-user",
    "firebase:config": "node scripts/write-firebase-config.mjs",
    "firebase:config:local": "node scripts/write-firebase-config.mjs --emulator"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.21.2",
    "@milkdown/ctx": "^7.21.2",
    "@milkdown/plugin-history": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/prose": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "firebase": "^12.14.0",
    "marked": "^18.0.5",
    "plantuml-encoder": "^1.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^15.19.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
