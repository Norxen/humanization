rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /documents/{documentId} {
      function validDocumentUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['body', 'version', 'lastReviewed', 'updatedAt'])
          && request.resource.data.path == resource.data.path
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 512000
          && request.resource.data.version == resource.data.version + 1
          && validDate(request.resource.data.lastReviewed)
          && request.resource.data.updatedAt == request.time
          && existsAfter(
            /databases/$(database)/documents/documents/$(documentId)/revisions/$(resource.data.version)
          );
      }

      allow read: if true;
      allow create, delete: if false;
      allow update: if validDocumentUpdate();

      match /revisions/{revisionId} {
        allow read: if true;
        allow update, delete: if false;
        allow create: if request.resource.data.keys().hasOnly([
            'path',
            'body',
            'version',
            'lastReviewed',
            'createdAt'
          ])
          && request.resource.data.path
            == get(/databases/$(database)/documents/documents/$(documentId)).data.path
          && request.resource.data.body
            == get(/databases/$(database)/documents/documents/$(documentId)).data.body
          && request.resource.data.version
            == get(/databases/$(database)/documents/documents/$(documentId)).data.version
          && request.resource.data.lastReviewed
            == get(/databases/$(database)/documents/documents/$(documentId)).data.lastReviewed
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/documents/$(documentId)).data.version
            == request.resource.data.version + 1;
      }
    }
  }
}
